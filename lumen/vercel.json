{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "node build.js",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/story/:slug", "destination": "/api/story?slug=:slug" }
  ],
  "redirects": [
    { "source": "/story.html", "has": [{ "type": "query", "key": "slug", "value": "(?<s>.*)" }], "destination": "/story/:s", "permanent": true },
    { "source": "/category.html", "has": [{ "type": "query", "key": "cat", "value": "(?<c>[^&]*)" }], "destination": "/category/:c", "permanent": true }
  ],
  "crons": [
    { "path": "/api/rebuild", "schedule": "0 7 * * *" }
  ]
}
